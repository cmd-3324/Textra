# Copy to `.env` and edit. Every value below is the built-in default, so a
# missing file is valid. Values are validated at startup: a typo stops the
# application with a message naming the variable instead of failing mid-import.

# ---- application ---------------------------------------------------------
TEXTRA_ENVIRONMENT=development            # development | test | production
TEXTRA_DEFAULT_ENGINE=auto                # auto | rapidocr | tesseract | <plugin name>

# ---- OCR ----------------------------------------------------------------
# RapidOCR: en, ch, chinese_cht, japan, korean, latin, cyrillic, arabic,
#           devanagari, ta, te, ka, th, el.
# Tesseract: eng, fas, deu, fra, ... (use eng+fas for a second script).
TEXTRA_OCR_LANGUAGE=en
TEXTRA_EXTRACTION_TIMEOUT_SECONDS=120     # hard ceiling for one image
TEXTRA_MIN_CONFIDENCE=0.0                 # drop recognised lines below this score

# Only needed when the tesseract executable is not on PATH.
TEXTRA_TESSERACT_CMD=
# Where RapidOCR caches downloaded models. Empty = the library default.
TEXTRA_MODEL_DIR=

# ---- image ingestion ----------------------------------------------------
TEXTRA_ALLOWED_FORMATS=PNG,JPEG,WEBP,BMP,TIFF
TEXTRA_MAX_IMAGE_BYTES=20971520           # 20 MiB
TEXTRA_MAX_IMAGE_PIXELS=80000000          # 80 MP, checked before decoding
TEXTRA_MAX_IMAGE_SIDE=15000
TEXTRA_MIN_IMAGE_SIDE=8

# ---- preprocessing ------------------------------------------------------
TEXTRA_PREPROCESS_ENABLED=true            # UI default; can be toggled per run
TEXTRA_PREPROCESS_AUTO_ORIENT=true        # honour EXIF orientation
TEXTRA_PREPROCESS_AUTOCONTRAST=true       # normalise faded scans
TEXTRA_PREPROCESS_DESKEW=true             # projection-profile skew correction
TEXTRA_PREPROCESS_MAX_DIMENSION=3600      # downscale larger images for OCR
TEXTRA_PREPROCESS_MIN_DIMENSION=0         # upscale tiny images to at least this

# ---- observability ------------------------------------------------------
TEXTRA_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
TEXTRA_LOG_FORMAT=console                 # console | json
TEXTRA_LOG_FILE=                          # e.g. logs/textra.log (rotated at 2 MiB)

# ---- desktop ------------------------------------------------------------
TEXTRA_UI_THEME=dark                      # dark | light
TEXTRA_UI_WINDOW_WIDTH=1180
TEXTRA_UI_WINDOW_HEIGHT=760
